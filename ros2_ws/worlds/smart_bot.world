<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Boundary walls -->
    <model name="left_boundary">
      <static>true</static>
      <pose>4 3 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>10 0.2 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="right_boundary">
      <static>true</static>
      <pose>4 -3 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>10 0.2 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="back_boundary">
      <static>true</static>
      <pose>9 0 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>0.2 6 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 6 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 1: central box -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>2.2 0 0.4 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.55 0.55 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.55 0.55 0.8</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: left-side pillar -->
    <model name="obstacle_2">
      <static>true</static>
      <pose>4.0 1.1 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: right-side box -->
    <model name="obstacle_3">
      <static>true</static>
      <pose>5.7 -0.9 0.4 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.7 0.5 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.5 0.8</size></box></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 4: central pillar -->
    <model name="obstacle_4">
      <static>true</static>
      <pose>7.2 0.8 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material><ambient>0.9 0.6 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Gazebo ground-truth state publisher -->
    <plugin name="gazebo_ros_state"
            filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>

  </world>
</sdf>
